<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DBDStudio.ViewModels"
        xmlns:pages="using:DBDStudio.Views.Pages"
        x:Class="DBDStudio.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Dynamic Body Distribution Studio"
        Width="1200" Height="760"
        MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterScreen">

    <!-- DataTemplates map each ViewModel to its page View -->
    <Window.DataTemplates>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <pages:SettingsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TexturePacksViewModel}">
            <pages:TexturePacksPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BodySlideViewModel}">
            <pages:BodySlidePage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RaceMenuPresetsViewModel}">
            <pages:RaceMenuPresetsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RulesViewModel}">
            <pages:RulesPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RulePreviewViewModel}">
            <pages:RulePreviewPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LoadOrderExplorerViewModel}">
            <pages:LoadOrderExplorerPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PreviewViewModel}">
            <pages:PreviewPage />
        </DataTemplate>
    </Window.DataTemplates>

    <DockPanel>

        <!-- ── Status Bar ── -->
        <Border DockPanel.Dock="Bottom"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemBaseMediumLowColor}"
                Padding="12,5">
            <TextBlock Text="{Binding StatusMessage}"
                       Classes="caption"
                       VerticalAlignment="Center" />
        </Border>

        <!-- ── Navigation + Content ── -->
        <Grid ColumnDefinitions="190,4,*">

            <!-- Navigation Sidebar -->
            <Border Grid.Column="0"
                    BorderThickness="0,0,1,0"
                    BorderBrush="{DynamicResource SystemBaseMediumLowColor}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="DBD Studio"
                               Classes="tiny"
                               FontWeight="Bold"
                               LetterSpacing="2"
                               Margin="14,14,14,8"
                               Opacity="0.45" />
                    <ListBox SelectedIndex="{Binding SelectedPageIndex}"
                             Margin="4,0">
                        <ListBoxItem Padding="10,9" Content="Settings" />
                        <ListBoxItem Padding="10,9" Content="Texture Packs" />
                        <ListBoxItem Padding="10,9" Content="BodySlide Presets" />
                       <ListBoxItem Padding="10,9" Content="RaceMenu Presets" />
                       <ListBoxItem Padding="10,9" Content="Rules" />
                       <ListBoxItem Padding="10,9" Content="Rule Preview" />
                       <ListBoxItem Padding="10,9" Content="Load Order Explorer" />
                       <ListBoxItem Padding="10,9" Content="Preview / Export" />
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Background="Transparent" />

            <!-- Active Page (resolved via DataTemplates above) -->
            <ContentControl Grid.Column="2"
                            Content="{Binding CurrentPage}" />

        </Grid>

    </DockPanel>
</Window>
