<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DBDStudio.ViewModels"
    xmlns:fluent="using:FluentIcons.Avalonia"
    x:Class="DBDStudio.Views.Pages.TexturePacksPage"
    x:DataType="vm:TexturePacksViewModel">

    <Grid ColumnDefinitions="230,4,*">

        <Border Grid.Column="0"
            BorderThickness="0,0,1,0"
            BorderBrush="{DynamicResource SystemBaseMediumLowColor}">

            <Grid RowDefinitions="Auto,*,Auto">

                <!-- Header + Toolbar -->
                <StackPanel Grid.Row="0"
                    Margin="12"
                    Spacing="10">

                    <TextBlock Text="Texture Packs"
                        Classes="h2" />

                    <StackPanel Orientation="Horizontal"
                        Spacing="6">

                        <Button Command="{Binding AddPackCommand}"
                            ToolTip.Tip="Create new texture pack"
                            Classes="icon">
                            <fluent:SymbolIcon Symbol="Add" />
                        </Button>

                        <Button Click="OnAddPackFromFolderClick"
                            ToolTip.Tip="Create pack from existing mod folder"
                            Classes="icon">
                            <fluent:SymbolIcon Symbol="FolderOpen" />
                        </Button>

                        <Button Command="{Binding DuplicatePackCommand}"
                            ToolTip.Tip="Duplicate selected pack"
                            Classes="icon">
                            <fluent:SymbolIcon Symbol="Copy" />
                        </Button>

                        <!-- if (SelectedPack) ... -->
                        <StackPanel Orientation="Horizontal"
                            Spacing="6"
                            HorizontalAlignment="Right"
                            IsVisible="{Binding SelectedPack, Converter={x:Static ObjectConverters.IsNotNull}}">

                            <Button Click="OnDeleteSelectedPackClick"
                                IsVisible="{Binding SelectedPack.State, Converter={StaticResource ConstructStateClassConverter}, ConverterParameter=is-ephemeral}"
                                ToolTip.Tip="Delete selected pack"
                                Classes="icon"
                                Foreground="#D13438">
                                <fluent:SymbolIcon Symbol="Delete" />
                            </Button>

                            <Button
                                IsVisible="{Binding SelectedPack.State, Converter={StaticResource ConstructStateClassConverter}, ConverterParameter=is-primordial}"
                                IsEnabled="False"
                                Classes="icon"
                                Opacity="0.45">
                                <fluent:SymbolIcon Symbol="ArrowUndo" />
                            </Button>

                            <Button Command="{Binding ResetPackCommand}"
                                IsVisible="{Binding SelectedPack.State, Converter={StaticResource ConstructStateClassConverter}, ConverterParameter=is-primordial-edited}"
                                ToolTip.Tip="Reset edited pack to its original file state"
                                Classes.icon="True"
                                Classes.construct-state="True"
                                Classes.ephemeral="{Binding SelectedPack.State, Converter={StaticResource ConstructStateClassConverter}, ConverterParameter=is-ephemeral}"
                                Classes.disk="{Binding SelectedPack.State, Converter={StaticResource ConstructStateClassConverter}, ConverterParameter=is-primordial}"
                                Classes.diskedited="{Binding SelectedPack.State, Converter={StaticResource ConstructStateClassConverter}, ConverterParameter=is-primordial-edited}"
                                Name="ResetSelectedPackButton">
                                <fluent:SymbolIcon Symbol="ArrowUndo" />
                            </Button>
                        </StackPanel>
                        <!-- Else... -->
                        <Button
                            IsVisible="{Binding SelectedPack, Converter={x:Static ObjectConverters.IsNull}}"
                            ToolTip.Tip="No pack selected"
                            IsEnabled="False"
                            Classes="icon">
                            <fluent:SymbolIcon Symbol="ArrowUndo" />
                        </Button>

                    </StackPanel>
                </StackPanel>

                <ListBox Grid.Row="1"
                    Margin="8,0"
                    ItemsSource="{Binding Packs}"
                    SelectedItem="{Binding SelectedPack}">

                    <ListBox.ItemTemplate>
                        <DataTemplate>

                            <Border Margin="4,2"
                                Padding="6,4"
                                CornerRadius="6"
                                Classes.construct-state="True"
                                Classes.ephemeral="{Binding State, Converter={StaticResource ConstructStateClassConverter}, ConverterParameter=is-ephemeral}"
                                Classes.disk="{Binding State, Converter={StaticResource ConstructStateClassConverter}, ConverterParameter=is-primordial}"
                                Classes.diskedited="{Binding State, Converter={StaticResource ConstructStateClassConverter}, ConverterParameter=is-primordial-edited}">

                                <Grid ColumnDefinitions="Auto,*,Auto">

                                    <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="0,0,6,0">

                                        <fluent:SymbolIcon Symbol="Globe"
                                            FontSize="{DynamicResource CaptionFontSize}"
                                            IsVisible="{Binding !IsPrivate}" />

                                        <fluent:SymbolIcon Symbol="LockClosed"
                                            FontSize="{DynamicResource CaptionFontSize}"
                                            IsVisible="{Binding IsPrivate}" />

                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                        Text="{Binding Name}"
                                        Classes="default"
                                        Padding="0,2"
                                        TextTrimming="CharacterEllipsis" />

                                    <Ellipse Grid.Column="2"
                                        Width="8"
                                        Height="8"
                                        VerticalAlignment="Center"
                                        Margin="8,0,0,0"
                                        Classes.construct-state="True"
                                        Classes.ephemeral="{Binding State, Converter={StaticResource ConstructStateClassConverter}, ConverterParameter=is-ephemeral}"
                                        Classes.disk="{Binding State, Converter={StaticResource ConstructStateClassConverter}, ConverterParameter=is-primordial}"
                                        Classes.diskedited="{Binding State, Converter={StaticResource ConstructStateClassConverter}, ConverterParameter=is-primordial-edited}"
                                        IsVisible="{Binding State, Converter={StaticResource ConstructStateClassConverter}, ConverterParameter=!is-primordial}" />

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Footer -->
                <Border Grid.Row="2"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource SystemBaseMediumLowColor}"
                    Padding="12">

                    <TextBlock Text="{Binding Packs.Count, StringFormat='{}{0} texture packs'}"
                        Opacity="0.6"
                        HorizontalAlignment="Center" />

                </Border>
            </Grid>
        </Border>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1"
            ResizeDirection="Columns"
            ResizeBehavior="PreviousAndNext"
            Background="Transparent" />

        <Grid Grid.Column="2">

            <!-- Placeholder -->
            <TextBlock Text="Select or create a texture pack to begin editing."
                Classes="default"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0.45"
                IsVisible="{Binding SelectedPack, Converter={x:Static ObjectConverters.IsNull}}" />

            <!-- Editor -->

            <Grid
                IsVisible="{Binding SelectedPack, Converter={x:Static ObjectConverters.IsNotNull}}"
                Margin="18"
                RowDefinitions="Auto,*,Auto">

                <Grid Grid.Row="0"
                    ColumnDefinitions="*,Auto"
                    Margin="0,0,0,18">

                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Texture Pack"
                                Classes="h1" />

                            <Border Margin="8,4,2,4"
                                Padding="8,2"
                                CornerRadius="10"
                                VerticalAlignment="Center"
                                Name="PackStateBadge"
                                Classes.construct-state="True"
                                Classes.ephemeral="{Binding SelectedPack.State, Converter={StaticResource ConstructStateClassConverter}, ConverterParameter=is-ephemeral}"
                                Classes.disk="{Binding SelectedPack.State, Converter={StaticResource ConstructStateClassConverter}, ConverterParameter=is-primordial}"
                                Classes.diskedited="{Binding SelectedPack.State, Converter={StaticResource ConstructStateClassConverter}, ConverterParameter=is-primordial-edited}">
                                <TextBlock Text="{Binding SelectedPack.State, Converter={StaticResource ConstructStateClassConverter}, ConverterParameter=label}"
                                    Name="PackStateLabel"
                                    Classes.construct-state="True"
                                    Classes.ephemeral="{Binding SelectedPack.State, Converter={StaticResource ConstructStateClassConverter}, ConverterParameter=is-ephemeral}"
                                    Classes.disk="{Binding SelectedPack.State, Converter={StaticResource ConstructStateClassConverter}, ConverterParameter=is-primordial}"
                                    Classes.diskedited="{Binding SelectedPack.State, Converter={StaticResource ConstructStateClassConverter}, ConverterParameter=is-primordial-edited}"
                                    FontSize="{DynamicResource CaptionFontSize}"
                                    FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>

                        <StackPanel Margin="0,12,0,0"
                            Spacing="10">

                            <StackPanel>
                                <TextBlock Text="Name"
                                    Classes="caption"
                                    FontWeight="SemiBold" />

                                <TextBox Text="{Binding SelectedPack.Name}"
                                    Classes="h2"
                                    PlaceholderText="Texture Pack Name" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Description"
                                    Classes="caption"
                                    FontWeight="SemiBold" />

                                <TextBox Text="{Binding SelectedPack.Description}"
                                    Classes="default"
                                    AcceptsReturn="True"
                                    Height="70"
                                    PlaceholderText="Description" />
                            </StackPanel>

                            <Grid ColumnDefinitions="Auto,*,Auto"
                                VerticalAlignment="Center">

                                <!-- Left -->
                                <CheckBox Grid.Column="0"
                                    IsChecked="{Binding SelectedPack.IsPrivate}"
                                    Content="Private pack"
                                    ToolTip.Tip="Private packs are excluded from random selection and are only used when explicitly added to a rule." />

                                <!-- Spacer -->
                                <Rectangle Grid.Column="1" />

                                <!-- Right -->
                                <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    VerticalAlignment="Center">

                                    <TextBlock Text="Last Updated:"
                                        Classes="caption"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center" />

                                    <TextBlock
                                        Text="{Binding SelectedPack.LastUpdatedLocal, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                        Classes="caption"
                                        VerticalAlignment="Center" />

                                </StackPanel>

                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <DataGrid x:Name="MappingsDataGrid"
                    Grid.Row="1"
                    ItemsSource="{Binding SelectedPack.Mappings}"
                    SelectedItem="{Binding SelectedMapping}"
                    AutoGenerateColumns="False"
                    CanUserResizeColumns="True"
                    GridLinesVisibility="Horizontal">

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Vanilla Texture (textures/...)"
                            Width="*">

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="8,0">
                                        <TextBlock Text="{Binding VanillaTexture}"
                                            VerticalAlignment="Center"
                                            TextWrapping="NoWrap"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip.Tip="{Binding VanillaTexture}" />

                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding VanillaTexture}"
                                        Margin="4,2"
                                        VerticalContentAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn
                            Header="Replacement Texture (textures/dbd/&lt;profile&gt;/...)"
                            Width="*">

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="8,0">
                                        <TextBlock Text="{Binding ReplacementTexture}"
                                            VerticalAlignment="Center"
                                            TextWrapping="NoWrap"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip.Tip="{Binding ReplacementTexture}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding ReplacementTexture}"
                                        Margin="4,2"
                                        VerticalContentAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header=""
                            Width="80">

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Spacing="2">

                                        <Button Tag="{Binding}"
                                            Click="OnBrowseTextureClick"
                                            ToolTip.Tip="Browse"
                                            Classes="icon">

                                            <fluent:SymbolIcon Symbol="FolderOpen" />
                                        </Button>

                                        <Button Tag="{Binding}"
                                            Click="OnDeleteMappingClick"
                                            ToolTip.Tip="Delete"
                                            Classes="icon"
                                            Foreground="#D13438">

                                            <fluent:SymbolIcon Symbol="Delete" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="2"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource SystemBaseMediumLowColor}"
                    Padding="0,12,0,0">

                    <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="6">

                        <!-- Add Row -->
                        <Button Tag="{Binding}"
                            Click="OnAddFolderClick">
                            <StackPanel Orientation="Horizontal"
                                Spacing="8">
                                <fluent:SymbolIcon Symbol="Add" />
                                <TextBlock Text="Import Folder"
                                    VerticalAlignment="Center"
                                    Classes="default" />
                            </StackPanel>
                        </Button>

                        <!-- Add Row -->
                        <Button Tag="{Binding}"
                            Click="OnAddMappingClick">
                            <StackPanel Orientation="Horizontal"
                                Spacing="8">
                                <fluent:SymbolIcon Symbol="Add" />
                                <TextBlock Text="Add Mapping"
                                    VerticalAlignment="Center"
                                    Classes="default" />
                            </StackPanel>
                        </Button>

                        <!-- Export -->
                        <Button Click="OnExportPackClick">
                            <StackPanel Orientation="Horizontal"
                                Spacing="8">

                                <fluent:SymbolIcon Symbol="Save" />
                                <TextBlock Text="Export ZIP"
                                    VerticalAlignment="Center"
                                    Classes="default" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
