<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluent="using:FluentIcons.Avalonia"
    xmlns:vm="using:DBDStudio.ViewModels"
    xmlns:conv="using:Avalonia.Data.Converters"
    xmlns:controls="using:DBDStudio.Views.Controls"
    x:Class="DBDStudio.Views.Pages.RulesPage"
    x:DataType="vm:RulesViewModel">

    <UserControl.Styles>
        <Style Selector="Border.invalid">
            <Setter Property="Background" Value="#22C84A4A" />
            <Setter Property="BorderBrush" Value="#C84A4A" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="230,4,*">

        <Border Grid.Column="0"
            BorderThickness="0,0,1,0"
            BorderBrush="{DynamicResource SystemBaseMediumLowColor}">

            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Grid.Row="0"
                    Margin="12"
                    Spacing="10">
                    <TextBlock Text="Rules"
                        Classes="h2" />

                    <StackPanel Orientation="Horizontal"
                        Spacing="6">
                        <Button Command="{Binding AddRuleCommand}"
                            ToolTip.Tip="Create a new rule"
                            Classes="icon">
                            <fluent:SymbolIcon Symbol="Add" />
                        </Button>

                        <Button Command="{Binding DuplicateRuleCommand}"
                            ToolTip.Tip="Duplicate selected rule"
                            Classes="icon">
                            <fluent:SymbolIcon Symbol="Copy" />
                        </Button>

                        <StackPanel Orientation="Horizontal"
                            Spacing="6"
                            IsVisible="{Binding SelectedRenderedRule, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <Button Command="{Binding DeleteRuleCommand}"
                                IsVisible="{Binding SelectedRuleState, Converter={StaticResource ConstructStateClassConverter}, ConverterParameter=is-ephemeral}"
                                ToolTip.Tip="Delete selected rule"
                                Classes="icon"
                                Foreground="#D13438">
                                <fluent:SymbolIcon Symbol="Delete" />
                            </Button>

                            <Button
                                IsVisible="{Binding SelectedRuleState, Converter={StaticResource ConstructStateClassConverter}, ConverterParameter=is-primordial}"
                                IsEnabled="False"
                                Classes="icon"
                                Opacity="0.45">
                                <fluent:SymbolIcon Symbol="ArrowUndo" />
                            </Button>

                            <Button Command="{Binding ResetRuleCommand}"
                                IsVisible="{Binding SelectedRuleState, Converter={StaticResource ConstructStateClassConverter}, ConverterParameter=is-primordial-edited}"
                                ToolTip.Tip="Reset edited rule to its original file state"
                                Classes.icon="True"
                                Classes.construct-state="True"
                                Classes.ephemeral="{Binding SelectedRuleState, Converter={StaticResource ConstructStateClassConverter}, ConverterParameter=is-ephemeral}"
                                Classes.disk="{Binding SelectedRuleState, Converter={StaticResource ConstructStateClassConverter}, ConverterParameter=is-primordial}"
                                Classes.diskedited="{Binding SelectedRuleState, Converter={StaticResource ConstructStateClassConverter}, ConverterParameter=is-primordial-edited}"
                                Name="ResetSelectedRuleButton">
                                <fluent:SymbolIcon Symbol="ArrowUndo" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <ListBox Grid.Row="1"
                    Margin="8,0"
                    ItemsSource="{Binding Rules}"
                    SelectedItem="{Binding SelectedRenderedRule}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="4,2"
                                Padding="6,4"
                                CornerRadius="6"
                                Classes.construct-state="True"
                                Classes.ephemeral="{Binding State, Converter={StaticResource ConstructStateClassConverter}, ConverterParameter=is-ephemeral}"
                                Classes.disk="{Binding State, Converter={StaticResource ConstructStateClassConverter}, ConverterParameter=is-primordial}"
                                Classes.diskedited="{Binding State, Converter={StaticResource ConstructStateClassConverter}, ConverterParameter=is-primordial-edited}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0"
                                        Text="{Binding Name}"
                                        Classes="default"
                                        Padding="0,2"
                                        TextTrimming="CharacterEllipsis" />

                                    <Ellipse Grid.Column="1"
                                        Width="8"
                                        Height="8"
                                        VerticalAlignment="Center"
                                        Margin="8,0,0,0"
                                        Classes.construct-state="True"
                                        Classes.ephemeral="{Binding State, Converter={StaticResource ConstructStateClassConverter}, ConverterParameter=is-ephemeral}"
                                        Classes.disk="{Binding State, Converter={StaticResource ConstructStateClassConverter}, ConverterParameter=is-primordial}"
                                        Classes.diskedited="{Binding State, Converter={StaticResource ConstructStateClassConverter}, ConverterParameter=is-primordial-edited}"
                                        IsVisible="{Binding State, Converter={StaticResource ConstructStateClassConverter}, ConverterParameter=!is-primordial}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="2"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource SystemBaseMediumLowColor}"
                    Padding="12">
                    <TextBlock Text="{Binding Rules.Count, StringFormat='{}{0} rules'}"
                        Opacity="0.6"
                        HorizontalAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1"
            ResizeDirection="Columns"
            ResizeBehavior="PreviousAndNext"
            Background="Transparent" />

        <Grid Grid.Column="2">
            <TextBlock Text="Select a rule to view and edit its details."
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0.45"
                IsVisible="{Binding SelectedRule, Converter={x:Static ObjectConverters.IsNull}}" />

            <Grid
                IsVisible="{Binding SelectedRule, Converter={x:Static ObjectConverters.IsNotNull}}"
                RowDefinitions="*,Auto">

                <ScrollViewer Grid.Row="0" Padding="16,12,16,0">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Rule"
                                        Classes="h1" />

                                    <Border Margin="8,4,2,4"
                                        Padding="8,2"
                                        CornerRadius="10"
                                        VerticalAlignment="Center"
                                        Name="RuleStateBadge"
                                        Classes.construct-state="True"
                                        Classes.ephemeral="{Binding SelectedRuleState, Converter={StaticResource ConstructStateClassConverter}, ConverterParameter=is-ephemeral}"
                                        Classes.disk="{Binding SelectedRuleState, Converter={StaticResource ConstructStateClassConverter}, ConverterParameter=is-primordial}"
                                        Classes.diskedited="{Binding SelectedRuleState, Converter={StaticResource ConstructStateClassConverter}, ConverterParameter=is-primordial-edited}">
                                        <TextBlock Text="{Binding SelectedRuleState, Converter={StaticResource ConstructStateClassConverter}, ConverterParameter=label}"
                                            Name="RuleStateLabel"
                                            Classes.construct-state="True"
                                            Classes.ephemeral="{Binding SelectedRuleState, Converter={StaticResource ConstructStateClassConverter}, ConverterParameter=is-ephemeral}"
                                            Classes.disk="{Binding SelectedRuleState, Converter={StaticResource ConstructStateClassConverter}, ConverterParameter=is-primordial}"
                                            Classes.diskedited="{Binding SelectedRuleState, Converter={StaticResource ConstructStateClassConverter}, ConverterParameter=is-primordial-edited}"
                                            FontSize="{DynamicResource CaptionFontSize}"
                                            FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Rule Name"
                                FontWeight="SemiBold"
                                Classes="h2" />
                            <TextBox Text="{Binding SelectedRule.Name}"
                                PlaceholderText="Descriptive rule name…" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Texture Assignments"
                                FontWeight="SemiBold"
                                Classes="default" />

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ComboBox ItemsSource="{Binding AvailableTexturePacks}"
                                    SelectedItem="{Binding SelectedTextureCandidateToAdd}"
                                    HorizontalAlignment="Stretch"
                                    MinWidth="220" />
                                <Button Content="Add"
                                    Command="{Binding AddTextureCandidateCommand}" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding SelectedRule.TextureCandidates}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Background="{DynamicResource SystemControlBackgroundChromeLowBrush}"
                                            CornerRadius="6"
                                            Margin="0,0,6,6"
                                            Padding="8,4">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                                <Button
                                                    Command="{Binding $parent[UserControl].DataContext.RemoveTextureCandidateCommand}"
                                                    CommandParameter="{Binding}"
                                                    Classes="icon"
                                                    ToolTip.Tip="Remove"
                                                    Foreground="#D13438">
                                                    <fluent:SymbolIcon Symbol="Delete" />
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="BodySlide Assignments"
                                FontWeight="SemiBold"
                                Classes="default" />

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ComboBox ItemsSource="{Binding AvailableBodySlidePresets}"
                                    SelectedItem="{Binding SelectedBodySlideCandidateToAdd}"
                                    HorizontalAlignment="Stretch"
                                    MinWidth="220" />
                                <Button Content="Add"
                                    Command="{Binding AddBodySlideCandidateCommand}" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding SelectedRule.BodySlideCandidates}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Background="{DynamicResource SystemControlBackgroundChromeLowBrush}"
                                            CornerRadius="6"
                                            Margin="0,0,6,6"
                                            Padding="8,4">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                                <Button
                                                    Command="{Binding $parent[UserControl].DataContext.RemoveBodySlideCandidateCommand}"
                                                    CommandParameter="{Binding}"
                                                    Classes="icon"
                                                    ToolTip.Tip="Remove"
                                                    Foreground="#D13438">
                                                    <fluent:SymbolIcon Symbol="Delete" />
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="RaceMenu Assignment"
                                    FontWeight="SemiBold"
                                    Classes="default" />

                                <fluent:SymbolIcon Symbol="Warning"
                                    Foreground="{DynamicResource SystemErrorTextColor}"
                                    IsVisible="{Binding RaceMenuAssignmentWarning, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                    Classes="icon" />

                                <ToolTip.Tip>
                                    <TextBlock Text="{Binding RaceMenuAssignmentWarning}"
                                        IsVisible="{Binding RaceMenuAssignmentWarning, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                        TextWrapping="Wrap"
                                        Classes="caption"
                                        MaxWidth="400" />
                                </ToolTip.Tip>
                            </StackPanel>

                            <ComboBox ItemsSource="{Binding AvailableRaceMenuPresets}"
                                SelectedItem="{Binding SelectedRule.RaceMenuCandidate}"
                                HorizontalAlignment="Stretch"
                                Classes="default" />
                        </StackPanel>

                        <StackPanel Spacing="6" Margin="0,8,0,8">
                            <TextBlock
                                Text="Conditions"
                                FontWeight="SemiBold"
                                Classes="h2" />

                            <controls:ConditionTable
                                Conditions="{Binding SelectedRule.Conditions}"
                                FormDatabase="{Binding FormDatabase}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="1"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource SystemBaseMediumLowColor}"
                    Padding="16,12,16,12">
                    <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                        <Button Click="OnSaveRuleClick"
                            ToolTip.Tip="Save rule"
                            Classes="accent"
                            IsEnabled="{Binding SelectedRuleState, Converter={StaticResource ConstructStateClassConverter}, ConverterParameter=!is-primordial}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <fluent:SymbolIcon Symbol="Save" />
                                <TextBlock Text="Save" VerticalAlignment="Center" Classes="default" />
                            </StackPanel>
                        </Button>

                        <Button Click="OnSaveRuleAsClick"
                            ToolTip.Tip="Save rule as"
                            Classes="accent">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <fluent:SymbolIcon Symbol="Save" />
                                <TextBlock Text="Save As" VerticalAlignment="Center" Classes="default" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
