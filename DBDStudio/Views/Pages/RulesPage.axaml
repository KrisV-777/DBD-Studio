<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluent="using:FluentIcons.Avalonia"
    xmlns:vm="using:DBDStudio.ViewModels"
    xmlns:conv="using:Avalonia.Data.Converters"
    xmlns:controls="using:DBDStudio.Views.Controls"
    x:Class="DBDStudio.Views.Pages.RulesPage"
    x:DataType="vm:RulesViewModel">

    <UserControl.Styles>
        <Style Selector="Border.invalid">
            <Setter Property="Background" Value="#22C84A4A" />
            <Setter Property="BorderBrush" Value="#C84A4A" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="210,4,*">

        <Border Grid.Column="0"
            BorderThickness="0,0,1,0"
            BorderBrush="{DynamicResource SystemBaseMediumLowColor}">
            <DockPanel>
                <Border DockPanel.Dock="Bottom"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource SystemBaseMediumLowColor}"
                    Padding="8">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Content="+ Add"
                            Command="{Binding AddRuleCommand}" />
                        <Button Content="Duplicate"
                            Command="{Binding DuplicateRuleCommand}" />
                        <Button Content="Delete"
                            Command="{Binding DeleteRuleCommand}" />
                    </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding Rules}"
                    SelectedItem="{Binding SelectedRule}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Padding="4,2" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1"
            ResizeDirection="Columns"
            ResizeBehavior="PreviousAndNext"
            Background="Transparent" />

        <Grid Grid.Column="2">
            <TextBlock Text="Select a rule to view and edit its details."
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0.45"
                IsVisible="{Binding SelectedRule, Converter={x:Static ObjectConverters.IsNull}}" />

            <DockPanel
                IsVisible="{Binding SelectedRule, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Border DockPanel.Dock="Bottom"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource SystemBaseMediumLowColor}"
                    Padding="16,10">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Conflict Preview"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Opacity="0.65" />
                        <ItemsControl ItemsSource="{Binding ConflictWarnings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                        FontSize="12"
                                        Foreground="{DynamicResource SystemErrorTextColor}"
                                        Opacity="0.85"
                                        Margin="0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <ScrollViewer Padding="16,12,16,0">
                    <StackPanel Spacing="16">
                        <!-- Name -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Rule Name"
                                FontWeight="SemiBold"
                                Classes="h2" />
                            <TextBox Text="{Binding SelectedRule.Name}"
                                PlaceholderText="Descriptive rule name…" />
                        </StackPanel>

                        <!-- Texture Assignments -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Texture Assignments"
                                FontWeight="SemiBold"
                                Classes="default" />

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ComboBox ItemsSource="{Binding AvailableTexturePacks}"
                                    SelectedItem="{Binding SelectedTextureCandidateToAdd}"
                                    HorizontalAlignment="Stretch"
                                    MinWidth="220" />
                                <Button Content="Add"
                                    Command="{Binding AddTextureCandidateCommand}" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding SelectedRule.TextureCandidates}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Background="{DynamicResource SystemControlBackgroundChromeLowBrush}"
                                            CornerRadius="6"
                                            Margin="0,0,6,6"
                                            Padding="8,4">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                                <Button
                                                    Command="{Binding $parent[UserControl].DataContext.RemoveTextureCandidateCommand}"
                                                    CommandParameter="{Binding}"
                                                    Classes="icon"
                                                    ToolTip.Tip="Remove"
                                                    Foreground="#D13438">
                                                    <fluent:SymbolIcon Symbol="Delete" />
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- BodySlide Assignments -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="BodySlide Assignments"
                                FontWeight="SemiBold"
                                Classes="default" />

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ComboBox ItemsSource="{Binding AvailableBodySlidePresets}"
                                    SelectedItem="{Binding SelectedBodySlideCandidateToAdd}"
                                    HorizontalAlignment="Stretch"
                                    MinWidth="220" />
                                <Button Content="Add"
                                    Command="{Binding AddBodySlideCandidateCommand}" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding SelectedRule.BodySlideCandidates}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Background="{DynamicResource SystemControlBackgroundChromeLowBrush}"
                                            CornerRadius="6"
                                            Margin="0,0,6,6"
                                            Padding="8,4">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                                <Button
                                                    Command="{Binding $parent[UserControl].DataContext.RemoveBodySlideCandidateCommand}"
                                                    CommandParameter="{Binding}"
                                                    Classes="icon"
                                                    ToolTip.Tip="Remove"
                                                    Foreground="#D13438">
                                                    <fluent:SymbolIcon Symbol="Delete" />
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- RaceMenu Assignment -->
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="RaceMenu Assignment"
                                    FontWeight="SemiBold"
                                    Classes="default" />

                                <fluent:SymbolIcon Symbol="Warning"
                                    Foreground="{DynamicResource SystemErrorTextColor}"
                                    IsVisible="{Binding RaceMenuAssignmentWarning, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                    Classes="icon" />

                                <ToolTip.Tip>
                                    <TextBlock Text="{Binding RaceMenuAssignmentWarning}"
                                        IsVisible="{Binding RaceMenuAssignmentWarning, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                        TextWrapping="Wrap"
                                        Classes="caption"
                                        MaxWidth="400" />
                                </ToolTip.Tip>
                            </StackPanel>

                            <ComboBox ItemsSource="{Binding AvailableRaceMenuPresets}"
                                SelectedItem="{Binding SelectedRule.RaceMenuCandidate}"
                                HorizontalAlignment="Stretch"
                                Classes="default" />
                        </StackPanel>

                        <StackPanel Spacing="6" Margin="0,8,0,8">
                            <TextBlock
                                Text="Conditions"
                                FontWeight="SemiBold"
                                Classes="h2" />

                            <controls:ConditionTable
                                Conditions="{Binding SelectedRule.Conditions}"
                                FormDatabase="{Binding FormDatabase}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
