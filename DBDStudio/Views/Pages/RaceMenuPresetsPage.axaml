<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DBDStudio.ViewModels"
    x:Class="DBDStudio.Views.Pages.RaceMenuPresetsPage"
    x:DataType="vm:RaceMenuPresetsViewModel">

    <Grid Margin="12"
        RowDefinitions="Auto,*,Auto">

        <Grid Grid.Row="0"
            ColumnDefinitions="*,300"
            Margin="0,0,0,12">

            <TextBlock Grid.Column="0"
                Text="RaceMenu Presets"
                Classes="h2"
                FontWeight="SemiBold"
                VerticalAlignment="Center" />

            <TextBox Grid.Column="1"
                Text="{Binding SearchText}"
                Classes="default"
                PlaceholderText="Search presets…"
                VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="1"
            BorderBrush="{DynamicResource SystemBaseMediumLowColor}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="8">

            <DataGrid ItemsSource="{Binding FilteredPresets}"
                AutoGenerateColumns="False"
                CanUserResizeColumns="True"
                GridLinesVisibility="Horizontal">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name"
                        Binding="{Binding Name}"
                        IsReadOnly="True"
                        Width="*" />

                    <DataGridTextColumn Header="File"
                        Binding="{Binding JslotFile}"
                        IsReadOnly="True"
                        Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2"
            Margin="0,10,0,0"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource SystemBaseMediumLowColor}"
            Padding="12,8">
            <TextBlock Text="{Binding FilteredPresets.Count, StringFormat='{}{0} presets'}"
                Opacity="0.6"
                HorizontalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>
