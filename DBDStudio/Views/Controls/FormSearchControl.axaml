<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DBDStudio.Views.Controls"
    x:Class="DBDStudio.Views.Controls.FormSearchControl"
    x:DataType="controls:FormSearchControl">

    <TextBox x:Name="SearchBox"
        Text="{Binding QueryText, RelativeSource={RelativeSource AncestorType=controls:FormSearchControl}, Mode=TwoWay}"
        ToolTip.Tip="{Binding SearchTooltip, RelativeSource={RelativeSource AncestorType=controls:FormSearchControl}}"
        PlaceholderText="Search by EditorID, Name, FormID or Plugin"
        GotFocus="OnSearchBoxGotFocus"
        LostFocus="OnSearchBoxLostFocus"
        TextChanged="OnSearchBoxTextChanged"
        KeyDown="OnSearchBoxKeyDown" />

</UserControl>
