<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluent="using:FluentIcons.Avalonia"
    xmlns:controls="using:DBDStudio.Views.Controls"
    x:Class="DBDStudio.Views.Controls.CandidateSelector"
    x:DataType="controls:CandidateSelector">

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
            Padding="10,8"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{DynamicResource SystemBaseMediumLowColor}"
            Background="{DynamicResource SystemControlBackgroundChromeLowBrush}">
            <Grid ColumnDefinitions="*,Auto">
                <Button Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    Click="OnToggleExpandedClick">
                    <TextBlock
                        Text="{Binding SelectedSummaryText, RelativeSource={RelativeSource AncestorType=controls:CandidateSelector}}"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center" />
                </Button>

                <Button Grid.Column="1"
                    Width="30"
                    Height="30"
                    Margin="8,0,0,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Classes="icon"
                    Click="OnToggleExpandedClick">
                    <fluent:SymbolIcon Symbol="ChevronDown">
                        <fluent:SymbolIcon.RenderTransform>
                            <RotateTransform
                                Angle="{Binding ExpansionRotation, RelativeSource={RelativeSource AncestorType=controls:CandidateSelector}}" />
                        </fluent:SymbolIcon.RenderTransform>
                    </fluent:SymbolIcon>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="1"
            IsVisible="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=controls:CandidateSelector}}"
            Margin="0,8,0,0"
            Padding="6"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{DynamicResource SystemBaseMediumLowColor}"
            Background="{DynamicResource SystemControlBackgroundChromeLowBrush}">
            <ScrollViewer MaxHeight="260">
                <ItemsControl
                    ItemsSource="{Binding Rows, RelativeSource={RelativeSource AncestorType=controls:CandidateSelector}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto">
                                <Button Grid.Column="0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Background="Transparent"
                                    Margin="8,0,0,0"
                                    Tag="{Binding}"
                                    Click="OnRowClick">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <CheckBox Grid.Column="0"
                                            IsChecked="{Binding IsSelected}"
                                            IsHitTestVisible="False"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                            Text="{Binding Candidate.Name}"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </Button>

                                <CheckBox Grid.Column="1"
                                    IsChecked="{Binding IsExclusive}"
                                    IsVisible="{Binding !IsRandom}"
                                    ToolTip.Tip="If checked, this candidate cannot be used for random/any selection."
                                    Margin="8,0,8,0"
                                    MinWidth="90"
                                    Click="OnExclusiveToggleClick">

                                    <TextBlock Text="Exclusive" VerticalAlignment="Center" />
                                </CheckBox>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
