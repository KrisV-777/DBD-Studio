<Styles xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceInclude Source="/Styles/Theme/Light.axaml" />
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceInclude Source="/Styles/Theme/Dark.axaml" />
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceInclude Source="/Styles/Theme/Dark.axaml" />
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- State background in pack list items -->
    <Style Selector="Border.construct-state.disk">
        <Setter Property="Background" Value="{DynamicResource TexturePackDiskListBackgroundBrush}" />
    </Style>

    <Style Selector="Border.construct-state.diskedited">
        <Setter Property="Background" Value="{DynamicResource TexturePackDiskEditedListBackgroundBrush}" />
    </Style>

    <Style Selector="Border.construct-state.ephemeral">
        <Setter Property="Background" Value="{DynamicResource TexturePackEphemeralListBackgroundBrush}" />
    </Style>

    <!-- State dot in pack list items -->
    <Style Selector="Ellipse.construct-state.disk">
        <Setter Property="Fill" Value="{DynamicResource TexturePackDiskAccentBrush}" />
    </Style>

    <Style Selector="Ellipse.construct-state.diskedited">
        <Setter Property="Fill" Value="{DynamicResource TexturePackDiskEditedAccentBrush}" />
    </Style>

    <Style Selector="Ellipse.construct-state.ephemeral">
        <Setter Property="Fill" Value="{DynamicResource TexturePackEphemeralAccentBrush}" />
    </Style>

    <!-- Selected pack badge -->
    <Style Selector="Border#PackStateBadge.construct-state.disk">
        <Setter Property="Background" Value="{DynamicResource TexturePackDiskBadgeBackgroundBrush}" />
    </Style>

    <Style Selector="Border#PackStateBadge.construct-state.diskedited">
        <Setter Property="Background" Value="{DynamicResource TexturePackDiskEditedBadgeBackgroundBrush}" />
    </Style>

    <Style Selector="Border#PackStateBadge.construct-state.ephemeral">
        <Setter Property="Background" Value="{DynamicResource TexturePackEphemeralBadgeBackgroundBrush}" />
    </Style>

    <Style Selector="TextBlock#PackStateLabel.construct-state.disk">
        <Setter Property="Foreground" Value="{DynamicResource TexturePackDiskAccentBrush}" />
    </Style>

    <Style Selector="TextBlock#PackStateLabel.construct-state.diskedited">
        <Setter Property="Foreground" Value="{DynamicResource TexturePackDiskEditedAccentBrush}" />
    </Style>

    <Style Selector="TextBlock#PackStateLabel.construct-state.ephemeral">
        <Setter Property="Foreground" Value="{DynamicResource TexturePackEphemeralAccentBrush}" />
    </Style>

    <!-- Reset icon color for edited packs -->
    <Style Selector="Button#ResetSelectedPackButton.construct-state.diskedited">
        <Setter Property="Foreground" Value="{DynamicResource TexturePackDiskEditedAccentBrush}" />
    </Style>

    <!-- State background in rule list items -->
    <Style Selector="Border#RuleStateBadge.construct-state.disk">
        <Setter Property="Background" Value="{DynamicResource TexturePackDiskBadgeBackgroundBrush}" />
    </Style>

    <Style Selector="Border#RuleStateBadge.construct-state.diskedited">
        <Setter Property="Background" Value="{DynamicResource TexturePackDiskEditedBadgeBackgroundBrush}" />
    </Style>

    <Style Selector="Border#RuleStateBadge.construct-state.ephemeral">
        <Setter Property="Background" Value="{DynamicResource TexturePackEphemeralBadgeBackgroundBrush}" />
    </Style>

    <Style Selector="TextBlock#RuleStateLabel.construct-state.disk">
        <Setter Property="Foreground" Value="{DynamicResource TexturePackDiskAccentBrush}" />
    </Style>

    <Style Selector="TextBlock#RuleStateLabel.construct-state.diskedited">
        <Setter Property="Foreground" Value="{DynamicResource TexturePackDiskEditedAccentBrush}" />
    </Style>

    <Style Selector="TextBlock#RuleStateLabel.construct-state.ephemeral">
        <Setter Property="Foreground" Value="{DynamicResource TexturePackEphemeralAccentBrush}" />
    </Style>

    <Style Selector="Button#ResetSelectedRuleButton.construct-state.diskedited">
        <Setter Property="Foreground" Value="{DynamicResource TexturePackDiskEditedAccentBrush}" />
    </Style>

    <!-- Plugin load-state tint in form database table rows -->
    <Style Selector="Border.plugin-load-state.notloaded">
        <Setter Property="Background" Value="{DynamicResource PluginNotLoadedListBackgroundBrush}" />
    </Style>

    <Style Selector="Border.plugin-load-state.loading">
        <Setter Property="Background" Value="{DynamicResource PluginLoadingListBackgroundBrush}" />
    </Style>

    <Style Selector="Border.plugin-load-state.loaded">
        <Setter Property="Background" Value="{DynamicResource PluginLoadedListBackgroundBrush}" />
    </Style>

    <Style Selector="Ellipse.plugin-load-state.notloaded">
        <Setter Property="Fill" Value="{DynamicResource PluginNotLoadedAccentBrush}" />
    </Style>

    <Style Selector="Ellipse.plugin-load-state.loading">
        <Setter Property="Fill" Value="{DynamicResource PluginLoadingAccentBrush}" />
    </Style>

    <Style Selector="Ellipse.plugin-load-state.loaded">
        <Setter Property="Fill" Value="{DynamicResource PluginLoadedAccentBrush}" />
    </Style>

    <Style Selector="TextBlock.plugin-load-state.notloaded">
        <Setter Property="Foreground" Value="{DynamicResource PluginNotLoadedAccentBrush}" />
    </Style>

    <Style Selector="TextBlock.plugin-load-state.loading">
        <Setter Property="Foreground" Value="{DynamicResource PluginLoadingAccentBrush}" />
    </Style>

    <Style Selector="TextBlock.plugin-load-state.loaded">
        <Setter Property="Foreground" Value="{DynamicResource PluginLoadedAccentBrush}" />
    </Style>
</Styles>
