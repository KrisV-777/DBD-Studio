<Styles
    xmlns="https://github.com/avaloniaui">

    <Style Selector="Button.icon">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />

        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />

        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.icon:pointerover">
        <Setter Property="Background"
            Value="{DynamicResource SystemControlHighlightListLowBrush}" />
    </Style>

    <Style Selector="Button.icon:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <Style Selector="Button.icon:pressed">
        <Setter Property="Background"
            Value="{DynamicResource SystemControlHighlightListMediumBrush}" />
    </Style>

</Styles>