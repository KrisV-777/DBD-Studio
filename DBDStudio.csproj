<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <ApplicationManifest>DBDStudio/app.manifest</ApplicationManifest>
        <EnableDefaultItems>false</EnableDefaultItems>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="DBDStudio/**/*.cs" Exclude="DBDStudio/bin/**;DBDStudio/obj/**;DBDStudio/dist/**" Link="%(RecursiveDir)%(Filename)%(Extension)" />
        <AvaloniaXaml Include="DBDStudio/**/*.axaml" Exclude="DBDStudio/bin/**;DBDStudio/obj/**;DBDStudio/dist/**" Link="%(RecursiveDir)%(Filename)%(Extension)" />
        <AvaloniaResource Include="DBDStudio/Assets/**" Link="Assets/%(RecursiveDir)%(Filename)%(Extension)" />
        <None Include="DBDStudio/app.manifest" Link="app.manifest" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.1" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
        <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.0" />
        <PackageReference Include="FluentIcons.Avalonia" Version="2.1.333" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.13" />
        <PackageReference Include="Mutagen.Bethesda.Skyrim" Version="0.54.2" />
    </ItemGroup>
</Project>
