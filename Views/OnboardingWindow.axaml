<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DBDStudio.ViewModels"
        xmlns:controls="using:DBDStudio.Views.Controls"
        x:Class="DBDStudio.Views.OnboardingWindow"
        x:DataType="vm:OnboardingViewModel"
        Title="DBD Studio — Onboarding"
        Width="720" Height="560"
        WindowStartupLocation="CenterScreen"
        CanResize="False">
    <ScrollViewer>
        <StackPanel Margin="28" Spacing="24">
            <StackPanel Spacing="4">
                <TextBlock Text="Welcome to DBD Studio"
                           FontSize="21"
                           FontWeight="SemiBold" />
                <TextBlock Text="Set up your Skyrim environment and start creating rules with a consistent, shared settings model."
                           TextWrapping="Wrap"
                           Opacity="0.7" />
            </StackPanel>

            <StackPanel Spacing="16">
                <StackPanel Spacing="6">
                    <TextBlock Text="Skyrim Data Folder" FontWeight="SemiBold" />
                    <controls:FilePathPickerControl Text="{Binding SkyrimDataFolder}"
                                                    PickerTitle="Select Skyrim Data folder"
                                                    PlaceholderText="e.g. C:\Steam\steamapps\common\Skyrim Special Edition\Data" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Mods Folder" FontWeight="SemiBold" />
                    <controls:FilePathPickerControl Text="{Binding ModsFolder}"
                                                    PickerTitle="Select Mods folder"
                                                    PlaceholderText="e.g. C:\Mod Organizer 2\mods" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="BodySlide Presets Folder" FontWeight="SemiBold" />
                    <controls:FilePathPickerControl Text="{Binding BodySlidePresetsFolder}"
                                                    PickerTitle="Select BodySlide folder"
                                                    PlaceholderText="e.g. C:\BodySlide\SliderPresets" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="RaceMenu Presets Folder" FontWeight="SemiBold" />
                    <controls:FilePathPickerControl Text="{Binding RaceMenuPresetsFolder}"
                                                    PickerTitle="Select RaceMenu presets folder"
                                                    PlaceholderText="e.g. C:\Skyrim\Data\Meshes\MyPreset" />
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Continue"
                        Classes="accent"
                        Command="{Binding ContinueCommand}" />
                <Button Content="Skip"
                        Command="{Binding SkipCommand}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
