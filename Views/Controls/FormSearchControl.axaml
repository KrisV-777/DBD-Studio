<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:DBDStudio.Views.Controls"
             xmlns:models="using:DBDStudio.Core.Models"
             x:Class="DBDStudio.Views.Controls.FormSearchControl"
             x:DataType="controls:FormSearchControl">
    <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0"
                     Text="{Binding QueryText, RelativeSource={RelativeSource AncestorType=controls:FormSearchControl}}"
                     PlaceholderText="Search by EditorID, Name, FormID or Plugin" />
            <Button Grid.Column="1"
                    Content="Search"
                    Margin="8,0,0,0"
                    Click="OnSearchClicked" />
        </Grid>

        <ListBox ItemsSource="{Binding SearchResults, RelativeSource={RelativeSource AncestorType=controls:FormSearchControl}}"
                 SelectedItem="{Binding SelectedFormRecord, RelativeSource={RelativeSource AncestorType=controls:FormSearchControl}}"
                 MinHeight="140">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:FormRecord">
                    <Border Padding="8,6" CornerRadius="4" BorderBrush="{DynamicResource SystemBaseMediumLowColor}" BorderThickness="1">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding EditorId}" Opacity="0.7" FontSize="12" />
                            <TextBlock Text="{Binding FormId, StringFormat=X6}" Opacity="0.7"
                                FontSize="12" />
                            <TextBlock Text="{Binding Plugin}" Opacity="0.7" FontSize="12" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>
</UserControl>
