<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Body_Distribution_Studio.ViewModels"
             x:Class="Body_Distribution_Studio.Views.Pages.BodySlidePage"
             x:DataType="vm:BodySlideViewModel">

    <DockPanel Margin="16">

        <!-- ── Toolbar ── -->
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Spacing="10"
                    Margin="0,0,0,12">
            <TextBlock Text="BodySlide Presets"
                       FontSize="20"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <TextBox Text="{Binding SearchText}"
                     PlaceholderText="Search presets…"
                     Width="240"
                     VerticalAlignment="Center" />
        </StackPanel>

        <!-- ── Read-only grid ── -->
        <DataGrid ItemsSource="{Binding FilteredPresets}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserResizeColumns="True"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Preset"
                                    Binding="{Binding Preset}"
                                    Width="*" />
                <DataGridTextColumn Header="XML File"
                                    Binding="{Binding SourceXml}"
                                    Width="220" />
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</UserControl>
