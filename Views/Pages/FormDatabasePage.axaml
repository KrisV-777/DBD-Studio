<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DBDStudio.ViewModels"
    x:Class="DBDStudio.Views.Pages.FormDatabasePage"
    x:Name="Root"
    x:DataType="vm:FormDatabaseViewModel">
    <Grid ColumnDefinitions="320,4,*" Grid.Row="0" Margin="12">
        <Border Grid.Column="0"
            BorderBrush="{DynamicResource SystemBaseMediumLowColor}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="10">
            <Grid RowDefinitions="Auto,*,Auto,Auto">
                <StackPanel Grid.Row="0" Spacing="8">
                    <TextBlock Text="Loaded Plugins" Classes="h1" FontWeight="SemiBold" />
                    <TextBlock
                        Text="Enable/Disable plugins to list their records in the form database."
                        Opacity="0.7" TextWrapping="Wrap" Classes="caption" />
                    <TextBox Text="{Binding PluginSearchText}" PlaceholderText="Search plugins" />
                </StackPanel>

                <TableView Grid.Row="1"
                    Margin="10,10,0,10"
                    CanUserResizeColumns="False"
                    Tapped="OnPluginRowTapped"
                    Background="Transparent"
                    ItemsSource="{Binding Plugins}">

                    <TableView.Columns>
                        <TableViewColumn Header="Plugin" Width="*"
                            HorizontalContentAlignment="Stretch">
                            <TableViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="10,6"
                                        Margin="0,1,2,1"
                                        CornerRadius="0,4,4,0"
                                        HorizontalAlignment="Stretch"
                                        Classes.plugin-load-state="True"
                                        Classes.notloaded="{Binding LoadState, Converter={StaticResource PluginLoadStateClassConverter}, ConverterParameter=is-notloaded}"
                                        Classes.loading="{Binding LoadState, Converter={StaticResource PluginLoadStateClassConverter}, ConverterParameter=is-loading}"
                                        Classes.loaded="{Binding LoadState, Converter={StaticResource PluginLoadStateClassConverter}, ConverterParameter=is-loaded}">

                                        <Grid ColumnDefinitions="Auto,*,Auto"
                                            ColumnSpacing="8">
                                            <CheckBox Grid.Column="0"
                                                IsChecked="{Binding IsEnabled}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="1"
                                                Text="{Binding PluginName}"
                                                Classes="default"
                                                TextTrimming="CharacterEllipsis"
                                                VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                Spacing="6"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">

                                                <Ellipse Width="7"
                                                    Height="7"
                                                    VerticalAlignment="Center"
                                                    Classes.plugin-load-state="True"
                                                    Classes.notloaded="{Binding LoadState, Converter={StaticResource PluginLoadStateClassConverter}, ConverterParameter=is-notloaded}"
                                                    Classes.loading="{Binding LoadState, Converter={StaticResource PluginLoadStateClassConverter}, ConverterParameter=is-loading}"
                                                    Classes.loaded="{Binding LoadState, Converter={StaticResource PluginLoadStateClassConverter}, ConverterParameter=is-loaded}" />

                                                <TextBlock Text="{Binding LoadState, Converter={StaticResource PluginLoadStateClassConverter}, ConverterParameter=label}"
                                                    FontSize="{DynamicResource CaptionFontSize}"
                                                    FontWeight="SemiBold"
                                                    Classes="caption"
                                                    Classes.plugin-load-state="True"
                                                    Classes.notloaded="{Binding LoadState, Converter={StaticResource PluginLoadStateClassConverter}, ConverterParameter=is-notloaded}"
                                                    Classes.loading="{Binding LoadState, Converter={StaticResource PluginLoadStateClassConverter}, ConverterParameter=is-loading}"
                                                    Classes.loaded="{Binding LoadState, Converter={StaticResource PluginLoadStateClassConverter}, ConverterParameter=is-loaded}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </TableViewColumn.CellTemplate>
                        </TableViewColumn>
                    </TableView.Columns>
                </TableView>

                <CheckBox Grid.Row="2" Content="Hide Empty Plugins" Margin="8,5,0,5"
                    IsChecked="{Binding HideEmptyPlugins}" />

                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                    <Button Content="Enable All" Command="{Binding EnableAllPluginsCommand}" />
                    <Button Content="Disable All" Command="{Binding DisableAllPluginsCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />

        <Border Grid.Column="2"
            BorderBrush="{DynamicResource SystemBaseMediumLowColor}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="16">
            <Grid RowDefinitions="Auto,*">
                <StackPanel Grid.Row="0" Spacing="8">
                    <TextBlock Text="Loaded Records" FontSize="18" FontWeight="SemiBold" />
                    <TextBox Text="{Binding SearchText}" PlaceholderText="Search records" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <DataGrid ItemsSource="{Binding Records}"
                        AutoGenerateColumns="False"
                        CanUserSortColumns="True"
                        GridLinesVisibility="All"
                        HeadersVisibility="Column"
                        IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name"
                                Binding="{Binding Name}"
                                SortMemberPath="Name"
                                Width="3*" />
                            <DataGridTextColumn Header="Source Plugin"
                                Binding="{Binding Plugin}"
                                SortMemberPath="Plugin"
                                Width="2*" />
                            <DataGridTextColumn Header="Record Type"
                                Binding="{Binding RecordType}"
                                SortMemberPath="RecordType"
                                Width="2*" />
                            <DataGridTextColumn Header="EditorID"
                                Binding="{Binding EditorId}"
                                SortMemberPath="EditorId"
                                Width="2*" />
                            <DataGridTextColumn Header="FormID"
                                Binding="{Binding FormId, StringFormat=X6}"
                                SortMemberPath="FormId"
                                Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
