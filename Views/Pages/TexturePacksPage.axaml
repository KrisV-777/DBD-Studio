<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DBDStudio.ViewModels"
    xmlns:fluent="using:FluentIcons.Avalonia"
    x:Class="DBDStudio.Views.Pages.TexturePacksPage"
    x:DataType="vm:TexturePacksViewModel">

    <Grid ColumnDefinitions="230,4,*">

        <Border Grid.Column="0"
            BorderThickness="0,0,1,0"
            BorderBrush="{DynamicResource SystemBaseMediumLowColor}">

            <Grid RowDefinitions="Auto,*,Auto">

                <!-- Header + Toolbar -->
                <StackPanel Grid.Row="0"
                    Margin="12"
                    Spacing="10">

                    <TextBlock Text="Texture Packs"
                        Classes="subtitle" />

                    <StackPanel Orientation="Horizontal"
                        Spacing="6">

                        <Button Command="{Binding AddPackCommand}"
                            ToolTip.Tip="Create new texture pack"
                            Classes="icon">
                            <fluent:SymbolIcon Symbol="Add" />
                        </Button>

                        <Button Click="OnAddPackFromFolderClick"
                            ToolTip.Tip="Create pack from existing mod folder"
                            Classes="icon">
                            <fluent:SymbolIcon Symbol="FolderOpen" />
                        </Button>

                        <Button Command="{Binding DuplicatePackCommand}"
                            ToolTip.Tip="Duplicate selected pack"
                            Classes="icon">
                            <fluent:SymbolIcon Symbol="Copy" />
                        </Button>

                        <Button Command="{Binding DeletePackCommand}"
                            ToolTip.Tip="Delete selected pack"
                            Classes="icon"
                            Foreground="#D13438">
                            <fluent:SymbolIcon Symbol="Delete" />
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Pack List -->
                <ListBox Grid.Row="1"
                    Margin="8,0"
                    ItemsSource="{Binding Packs}"
                    SelectedItem="{Binding SelectedPack}">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"
                                Padding="6,4" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Footer -->
                <Border Grid.Row="2"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource SystemBaseMediumLowColor}"
                    Padding="12">

                    <TextBlock Text="{Binding Packs.Count, StringFormat='{}{0} texture packs'}"
                        Opacity="0.6"
                        HorizontalAlignment="Center" />

                </Border>
            </Grid>
        </Border>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1"
            ResizeDirection="Columns"
            ResizeBehavior="PreviousAndNext"
            Background="Transparent" />

        <Grid Grid.Column="2">

            <!-- Placeholder -->
            <TextBlock Text="Select a texture pack to begin editing."
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0.45"
                IsVisible="{Binding SelectedPack, Converter={x:Static ObjectConverters.IsNull}}" />

            <!-- Editor -->

            <Grid
                IsVisible="{Binding SelectedPack, Converter={x:Static ObjectConverters.IsNotNull}}"
                Margin="18"
                RowDefinitions="Auto,*,Auto">

                <Grid Grid.Row="0"
                    ColumnDefinitions="*,Auto"
                    Margin="0,0,0,18">

                    <StackPanel>
                        <TextBlock Text="Texture Pack"
                            Classes="subtitle" />

                        <StackPanel Margin="0,12,0,0"
                            Spacing="10">

                            <StackPanel>
                                <TextBlock Text="Name"
                                    FontWeight="SemiBold" />

                                <TextBox Text="{Binding SelectedPack.Name}"
                                    PlaceholderText="Texture Pack Name" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Description"
                                    FontWeight="SemiBold" />

                                <TextBox Text="{Binding SelectedPack.Description}"
                                    AcceptsReturn="True"
                                    Height="70"
                                    PlaceholderText="Description" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Export -->
                    <Button Grid.Column="1"
                        VerticalAlignment="Top"
                        Command="{Binding ExportPackCommand}"
                        Classes="accent">

                        <StackPanel Orientation="Horizontal"
                            Spacing="8">

                            <fluent:SymbolIcon Symbol="Save" />
                            <TextBlock Text="Export ZIP" />
                        </StackPanel>
                    </Button>
                </Grid>

                <DataGrid Grid.Row="1"
                    ItemsSource="{Binding SelectedPack.Mappings}"
                    SelectedItem="{Binding SelectedMapping}"
                    AutoGenerateColumns="False"
                    CanUserResizeColumns="True"
                    GridLinesVisibility="Horizontal">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Vanilla Texture"
                            Binding="{Binding VanillaTexture}"
                            Width="*" />

                        <DataGridTextColumn Header="Replacement Texture"
                            Binding="{Binding ReplacementTexture}"
                            Width="*" />

                        <DataGridTemplateColumn Header=""
                            Width="72">

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Spacing="2">

                                        <Button Tag="{Binding}"
                                            Click="OnBrowseTextureClick"
                                            ToolTip.Tip="Browse"
                                            Classes="icon">

                                            <fluent:SymbolIcon Symbol="FolderOpen" />
                                        </Button>

                                        <Button Tag="{Binding}"
                                            Click="OnDeleteMappingClick"
                                            ToolTip.Tip="Delete"
                                            Classes="icon"
                                            Foreground="#D13438">

                                            <fluent:SymbolIcon Symbol="Delete" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="2"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource SystemBaseMediumLowColor}"
                    Padding="0,12,0,0">

                    <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                        <Button Command="{Binding AddMappingCommand}">
                            <StackPanel Orientation="Horizontal"
                                Spacing="8">
                                <fluent:SymbolIcon Symbol="Add" />
                                <TextBlock Text="Add Mapping" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>