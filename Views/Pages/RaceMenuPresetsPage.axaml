<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DBDStudio.ViewModels"
             x:Class="DBDStudio.Views.Pages.RaceMenuPresetsPage"
             x:DataType="vm:RaceMenuPresetsViewModel">
    <Grid ColumnDefinitions="300,4,*" Margin="16">
        <Border Grid.Column="0"
                BorderBrush="{DynamicResource SystemBaseMediumLowColor}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Spacing="8">
                    <TextBlock Text="RaceMenu Presets" FontSize="18" FontWeight="SemiBold" />
                    <TextBox Text="{Binding SearchText}" PlaceholderText="Search presets" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                    <Button Content="Add" Command="{Binding AddPresetCommand}" />
                    <Button Content="Delete" Command="{Binding DeletePresetCommand}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Presets}"
                         SelectedItem="{Binding SelectedPreset}"
                         Margin="0,10,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding JsSlotFile}" Opacity="0.7" FontSize="12" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />

        <Border Grid.Column="2"
                BorderBrush="{DynamicResource SystemBaseMediumLowColor}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16">
            <StackPanel Spacing="12">
                <TextBlock Text="Selected Preset" FontSize="18" FontWeight="SemiBold" />
                <TextBox Text="{Binding SelectedPreset.Name}" PlaceholderText="Name" />
                <ComboBox ItemsSource="{Binding SexOptions}"
                          SelectedItem="{Binding SelectedPreset.Sex}"
                          HorizontalAlignment="Stretch" />
                <TextBox Text="{Binding SelectedPreset.JsSlotFile}" PlaceholderText="JSLOT File" />
                <TextBox Text="{Binding SelectedPreset.NifFile}" PlaceholderText="NIF File" />
                <TextBox Text="{Binding SelectedPreset.DdsFile}" PlaceholderText="DDS File" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
