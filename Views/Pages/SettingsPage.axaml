<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DBDStudio.ViewModels"
             xmlns:controls="using:DBDStudio.Views.Controls"
             x:Class="DBDStudio.Views.Pages.SettingsPage"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer>
        <StackPanel Margin="28,20" Spacing="24" MaxWidth="680">

            <TextBlock Text="Settings"
                       FontSize="20"
                       FontWeight="SemiBold" />

            <!-- ── Asset Paths ── -->
            <StackPanel Spacing="16">
                <TextBlock Text="Asset Paths"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Opacity="0.65" />

                <StackPanel Spacing="6">
                    <TextBlock Text="Workspace File (.dbdproj)" />
                    <TextBox Text="{Binding WorkspaceFilePath}"
                             PlaceholderText="Path to workspace file, e.g. C:\Users\...\workspace.dbdproj" />
                </StackPanel>

                <!-- Skyrim Data -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Skyrim Data Folder" />
                    <controls:FilePathPickerControl Text="{Binding SkyrimDataFolder}"
                                                    PickerTitle="Select Skyrim Data folder"
                                                    PlaceholderText="Path to Skyrim Data folder…" />
                </StackPanel>

                <!-- Mods Folder -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Mods Folder" />
                    <controls:FilePathPickerControl Text="{Binding ModsFolder}"
                                                    PickerTitle="Select Mods folder"
                                                    PlaceholderText="Path to mods folder or MO2 virtual Data source…" />
                </StackPanel>

                <!-- BodySlide Presets -->
                <StackPanel Spacing="6">
                    <TextBlock Text="BodySlide Presets Folder" />
                    <controls:FilePathPickerControl Text="{Binding BodySlidePresetsFolder}"
                                                    PickerTitle="Select BodySlide folder"
                                                    PlaceholderText="Path to BodySlide slider preset folder…" />
                </StackPanel>

                <!-- RaceMenu Presets -->
                <StackPanel Spacing="6">
                    <TextBlock Text="RaceMenu Presets Folder" />
                    <controls:FilePathPickerControl Text="{Binding RaceMenuPresetsFolder}"
                                                    PickerTitle="Select RaceMenu presets folder"
                                                    PlaceholderText="Path to RaceMenu preset folder…" />
                </StackPanel>
            </StackPanel>

            <!-- ── Action Buttons ── -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Scan Assets"
                        Classes="accent"
                        IsEnabled="False"
                        ToolTip.Tip="Asset scanning will be available in a future update." />
                <Button Content="Save Settings"
                        Command="{Binding SaveCommand}" />
            </StackPanel>

            <!-- ── Info Cards ── -->
            <StackPanel Spacing="12">
                <TextBlock Text="Asset Summary"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Opacity="0.65" />

                <WrapPanel>
                    <Border BorderThickness="1"
                            BorderBrush="{DynamicResource SystemBaseMediumLowColor}"
                            CornerRadius="4"
                            Padding="16,12"
                            MinWidth="160"
                            Margin="0,0,12,8">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding TexturePacksFound}"
                                       FontSize="26"
                                       FontWeight="Bold" />
                            <TextBlock Text="Texture Packs Found"
                                       FontSize="12"
                                       Opacity="0.6" />
                        </StackPanel>
                    </Border>

                    <Border BorderThickness="1"
                            BorderBrush="{DynamicResource SystemBaseMediumLowColor}"
                            CornerRadius="4"
                            Padding="16,12"
                            MinWidth="160"
                            Margin="0,0,12,8">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding BodySlidePresetsFound}"
                                       FontSize="26"
                                       FontWeight="Bold" />
                            <TextBlock Text="BodySlide Presets Found"
                                       FontSize="12"
                                       Opacity="0.6" />
                        </StackPanel>
                    </Border>

                    <Border BorderThickness="1"
                            BorderBrush="{DynamicResource SystemBaseMediumLowColor}"
                            CornerRadius="4"
                            Padding="16,12"
                            MinWidth="160"
                            Margin="0,0,12,8">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding LastScanTime}"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Last Scan Time"
                                       FontSize="12"
                                       Opacity="0.6" />
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
