<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DBDStudio.ViewModels"
             x:Class="DBDStudio.Views.Pages.LoadOrderExplorerPage"
             x:DataType="vm:LoadOrderExplorerViewModel">
    <Grid ColumnDefinitions="320,4,*" Margin="16">
        <Border Grid.Column="0"
                BorderBrush="{DynamicResource SystemBaseMediumLowColor}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Spacing="8">
                    <TextBlock Text="Load Order Explorer" FontSize="18" FontWeight="SemiBold" />
                    <TextBox Text="{Binding SearchText}" PlaceholderText="Search records" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Records}"
                         SelectedItem="{Binding SelectedRecord}"
                         Margin="0,10,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Plugin}" Opacity="0.7" FontSize="12" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />

        <Border Grid.Column="2"
                BorderBrush="{DynamicResource SystemBaseMediumLowColor}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16">
            <StackPanel Spacing="12">
                <TextBlock Text="Record Details" FontSize="18" FontWeight="SemiBold" />
                <StackPanel Spacing="8">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Name" FontSize="12" Opacity="0.6" />
                        <TextBox Text="{Binding DetailName}" IsReadOnly="True" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="FormEditorID" FontSize="12" Opacity="0.6" />
                        <TextBox Text="{Binding DetailEditorId}" IsReadOnly="True" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="FormID" FontSize="12" Opacity="0.6" />
                        <TextBox Text="{Binding DetailFormId}" IsReadOnly="True" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Source Plugin" FontSize="12" Opacity="0.6" />
                        <TextBox Text="{Binding DetailPlugin}" IsReadOnly="True" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Record Type" FontSize="12" Opacity="0.6" />
                        <TextBox Text="{Binding DetailRecordType}" IsReadOnly="True" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Copy EditorID" Command="{Binding CopyEditorIdCommand}" />
                    <Button Content="Copy FormID" Command="{Binding CopyFormIdCommand}" />
                    <Button Content="Copy FormKey" Command="{Binding CopyFormKeyCommand}" />
                    <Button Content="Use In Rule" Command="{Binding UseInRuleCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
